{
  "name": "@datix/web",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file scripts/dev.ts",
    "build": "bun --no-env-file scripts/build-vitals.ts && bun --no-env-file run vite build && bun run build:tracker",
    "build:tracker": "bun scripts/build-tracker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "dev:frontend": "bun --no-env-file scripts/build-vitals.ts && bun --no-env-file run vite",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "bun run fmt",
    "format:check": "bun run fmt:check",
    "fmt": "oxlint --quiet --fix -A all -D spacing/padding-line-between-statements . && oxfmt .",
    "fmt:check": "oxlint --quiet -A all -D spacing/padding-line-between-statements . && oxfmt --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.36",
    "@types/bun": "^1.4.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "oxlint": "1.82.0",
    "oxfmt": "0.67.0"
  }
}
