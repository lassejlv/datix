{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "analytics",
  "account_id": "a3bad09d467f7e00ca2f879e28ecb620",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_URL": "http://localhost:3000" },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "VISITOR_HASH_SECRET", "POLAR_ACCESS_TOKEN"] },
  // Local-only placeholder. Provision a cache-disabled Hyperdrive pointing to Neon before deploying.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "analytics-events" }],
    "consumers": [
      {
        "queue": "analytics-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "analytics-events-dead",
      },
    ],
  },
  "ratelimits": [
    { "name": "COLLECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
  ],
  "triggers": { "crons": ["17 3 * * *", "* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "limits": { "cpu_ms": 10000 },
  "env": {
    "production": {
      "name": "analytics-beer",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "analytics.beer", "custom_domain": true }],
      "vars": { "APP_URL": "https://analytics.beer" },
      "triggers": { "crons": ["17 3 * * *", "* * * * *"] },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "VISITOR_HASH_SECRET", "POLAR_ACCESS_TOKEN"] },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "e3041622b8a14870998803e941b80821" }],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "analytics-events-production" }],
        "consumers": [
          {
            "queue": "analytics-events-production",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "analytics-events-dead-production",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "COLLECT_LIMITER",
          "namespace_id": "1101",
          "simple": { "limit": 120, "period": 60 },
        },
        { "name": "AUTH_LIMITER", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "1103", "simple": { "limit": 120, "period": 60 } },
      ],
    },
  },
}
