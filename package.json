{
  "name": "analytics",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev": "bun --bun vite dev --host 127.0.0.1 --port 3000",
    "build": "bun --bun vite build && bun run build:tracker",
    "build:production": "bun run build",
    "preview": "bun run start",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:production": "bun --env-file=.env.production scripts/migrate.ts --production",
    "test": "bun test tests/unit",
    "test:integration": "bun test --timeout 60000 tests/integration",
    "test:smoke": "bun scripts/smoke.ts",
    "test:browser": "bun scripts/browser-smoke.ts",
    "test:design": "bun scripts/design-state-check.ts",
    "deploy:check": "bun run typecheck && bun test tests/unit && bun run build",
    "build:tracker": "bun scripts/build-tracker.ts",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare CLOUDFLARE_ENV=production bun --bun vite build && bun run build:tracker",
    "start": "bun src/runtime/web.ts",
    "start:worker": "bun src/runtime/worker.ts",
    "deploy:cloudflare": "bun run build:cloudflare && bun --bun wrangler deploy --config dist/server/wrangler.json",
    "dev:worker": "bun --watch src/runtime/worker.ts",
    "deploy:web": "railway up --project ff5d734f-2a11-4fec-a74d-d2793515f557 --environment 3f8cf4d9-b6d5-4532-8e1c-dc8ced8a1b76 --service a5cb579e-e445-4882-a49f-6aea52c8480a --detach",
    "deploy:worker": "railway up --project ff5d734f-2a11-4fec-a74d-d2793515f557 --environment 3f8cf4d9-b6d5-4532-8e1c-dc8ced8a1b76 --service 90c910b8-2705-4b6b-b08a-b7b19e2dd9de --detach",
    "deploy": "bun run deploy:check && bun run deploy:web && bun run deploy:worker"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@polar-sh/sdk": "^0.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "better-auth": "^1.7.3",
    "bullmq": "^6.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "motion": "^13.2.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8",
    "wrangler": "^4.129.0"
  },
  "packageManager": "bun@1.4.2"
}
