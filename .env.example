# Axum/Rust app configuration. Use isolated development credentials.
APP_URL=http://localhost:3000
# Production also sets APP_LEGACY_URL=https://analytics.beer so existing tracker-host account flows keep working.
DATABASE_URL=postgres://USER:PASSWORD@YOUR-NEON-HOST/analytics?sslmode=verify-full
REDIS_URL=redis://127.0.0.1:6393
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
VISITOR_HASH_SECRET=replace-with-a-different-random-secret
AUTUMN_SECRET_KEY=
# Defaults to https://api.useautumn.com; override only for isolated provider tests.
AUTUMN_API_URL=https://api.useautumn.com

# Production uses separate api and worker services; combined is convenient for local development.
SERVICE_ROLE=combined
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
EVENT_WORKERS=4
EVENT_BATCH_SIZE=64
EVENT_BLOCK_MS=1000
QUEUE_MAX_PENDING=100000
REPORT_CACHE_SECONDS=5
BILLING_INTERVAL_MS=1000
BILLING_DRAIN_SECONDS=10
RETENTION_BATCH_SIZE=10000
RETENTION_DRAIN_SECONDS=20
RETENTION_MAX_ROWS_PER_PASS=250000
# Bearer token for /internal/metrics. Leave empty to disable this endpoint locally.
METRICS_TOKEN=

# Integration tests must use a separate Neon branch and isolated local Redis.
TEST_DATABASE_URL=postgres://USER:PASSWORD@YOUR-TEST-BRANCH-HOST/analytics?sslmode=verify-full
TEST_DATABASE_HOST=YOUR-TEST-BRANCH-HOST
RUST_TEST_REDIS_URL=redis://127.0.0.1:6394
