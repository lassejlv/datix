# Copy to .local/rust.env with isolated development credentials, never production.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://datix_runtime:password@your-project-pooler.neon.tech/datix?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://datix_owner:password@your-project.neon.tech/datix?sslmode=require
DB_MAX_CONNECTIONS=8
REDIS_URL=rediss://default:password@your-redis-host:6379
QUEUE_PREFIX=datix-rust-dev-20260914
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
VISITOR_HASH_SECRET=replace-with-a-stable-random-secret
PORT=3001
SERVICE_ROLE=combined
EVENT_BATCH_SIZE=64
EVENT_WORKERS=2
EXTERNAL_EFFECTS=disabled
BILLING_STATE_MODE=snapshot
ADMIN_EMAILS=
CLOUDFLARE_ORIGIN_SECRET=
# Required for signup verification: Cloudflare Email Sending token, account ID, and sender.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EMAIL_FROM=
METRICS_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Optional normalized import archive. Import metrics always live in Neon.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
