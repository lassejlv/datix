# Bun web and worker configuration. Use separate, isolated development credentials.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://USER:PASSWORD@YOUR-NEON-HOST/analytics?sslmode=verify-full
REDIS_URL=redis://127.0.0.1:6393
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
VISITOR_HASH_SECRET=replace-with-a-different-random-secret
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Integration tests must use a separate Neon branch and isolated local Redis.
TEST_DATABASE_URL=postgres://USER:PASSWORD@YOUR-TEST-BRANCH-HOST/analytics?sslmode=verify-full
TEST_DATABASE_HOST=YOUR-TEST-BRANCH-HOST
TEST_REDIS_URL=redis://127.0.0.1:6393
