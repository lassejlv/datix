{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "bun"]
  },
  "include": ["src", "scripts", "tests", "*.ts", "worker-configuration.d.ts"]
}
