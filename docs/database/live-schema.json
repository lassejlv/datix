  "functions": [
    {
      "name": "sync_default_environment",
      "definition": "CREATE OR REPLACE FUNCTION public.sync_default_environment()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  INSERT INTO public.environments (id, site_id, name, domain, enabled, allow_localhost, created_at)\n  VALUES (NEW.id, NEW.id, 'Production', NEW.domain, NEW.enabled, NEW.allow_localhost, NEW.created_at)\n  ON CONFLICT (id) DO UPDATE SET\n    domain = EXCLUDED.domain, enabled = EXCLUDED.enabled, allow_localhost = EXCLUDED.allow_localhost;\n  RETURN NEW;\nEND;\n$function$\n"
    }
  ],
  "triggers": [
    {
      "table_name": "sites",
      "name": "sites_default_environment",
      "definition": "CREATE TRIGGER sites_default_environment AFTER INSERT OR UPDATE OF domain, enabled, allow_localhost ON public.sites FOR EACH ROW EXECUTE FUNCTION sync_default_environment()"
    }
  ]
