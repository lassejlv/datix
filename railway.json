{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "/app/datix-db --allow-production deploy",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 180,
    "drainingSeconds": 90
  }
}
