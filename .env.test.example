# Dedicated initialized Neon test branch; must differ from DATABASE_URL_UNPOOLED.
TEST_DATABASE_HOST=your-test-branch.neon.tech
TEST_DATABASE_URL=postgresql://datix_owner:password@your-test-branch.neon.tech/datix?sslmode=require
TEST_RUNTIME_DATABASE_URL=postgresql://datix_runtime:password@your-test-branch-pooler.neon.tech/datix?sslmode=require
# Optional separate Redis; otherwise uses REDIS_URL with a unique integration prefix.
# TEST_REDIS_URL=redis://127.0.0.1:6379
