{
  "name": "@datix/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/dev.ts",
    "build": "bun scripts/build-vitals.ts && vp build && bun run build:tracker",
    "build:tracker": "bun scripts/build-tracker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "dev:frontend": "bun scripts/build-vitals.ts && vp dev",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "bun run fmt",
    "format:check": "bun run fmt:check",
    "fmt": "vp lint --quiet --fix -A all -D spacing/padding-line-between-statements && vp fmt",
    "fmt:check": "vp lint --quiet -A all -D spacing/padding-line-between-statements && vp fmt --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.36",
    "@types/bun": "^1.4.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  }
}
